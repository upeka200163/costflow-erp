{
  "name": "costflow-manufacturing-erp",
  "version": "1.0.0",
  "description": "CostFlow - Manufacturing Cost Management ERP for Water Bottling Factory",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "server": "node server/src/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "seed": "node server/src/scripts/seed.js",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "keywords": [
    "erp",
    "manufacturing",
    "cost-management",
    "water-bottling",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
